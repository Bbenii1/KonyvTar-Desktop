<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KönyvTár.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="KönyvTár.Views.LoginWindow"
        Title="KönyvTár — Belépés"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        >

    <Grid >
        <Button x:Name="ThemeButton" Classes="ModeSwitcher" ToolTip.Tip="Váltás sötét/világos mód között"
                Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,0,0" Padding="0" >
            <ic:MaterialIcon x:Name="ThemeIcon" Kind="MoonWaningCrescent" Width="22" Height="22"/>
        </Button>

        <Grid RowDefinitions="*, Auto, *" Margin="0">
                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0" >
                    <TextBlock Text="Bejelentkezés" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 30"/>

                    <TextBlock Text="E-mail cím" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="EmailTextBox" Margin="0,8,0,20"
                             Height="48" FontSize="15" Padding="14,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Jelszó" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="PasswordTextBox" PasswordChar="•" Margin="0,8,0,0"
                                 Height="48" FontSize="15" Padding="14,0" VerticalContentAlignment="Center"/>

                    <Button Content="Elfelejtetted a jelszavad?" Classes="linkButton" HorizontalAlignment="Right"
                            Margin="0,10,0,0"/>
                    <Button x:Name="LoginButton" Content="Belépés" Height="50" Width="300" HorizontalContentAlignment="Center" FontSize="15" Margin="0 20 0 0"
                            FontWeight="SemiBold" Classes="primaryButton" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="StatusText" Text="" Foreground="#C94C4C" FontSize="13"
                               TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
                </StackPanel>
            
                <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Bottom" Margin="0 0 0 10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Text="Nincs még fiókod?" Foreground="#68738A" VerticalAlignment="Center"/>
                        <Button Content="Regisztráció" Classes="linkButton"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="#9AA3B5" FontSize="12"/>
                </StackPanel>
            
                
            </Grid>
    </Grid>
</Window>
