<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.LoginPage">
    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="Bejelentkezés" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 30"/>
            <TextBlock Text="E-mail cím" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="EmailTextBox" Classes="inputArea"/>
            <TextBlock Text="Jelszó" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="PasswordTextBox" PasswordChar="•" Classes="inputArea"/>
            <Button x:Name="ForgotPasswordButton" Content="Elfelejtetted a jelszavad?" Classes="linkButton" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            <Button x:Name="CodeLoginButton" Content="Belépés e-mail kóddal" Classes="linkButton" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            <Button x:Name="LoginButton" Content="Belépés" Classes="primaryButton" />
            <TextBlock x:Name="StatusText" Foreground="#C94C4C" FontSize="13" TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0 0 0 10" Spacing="5">
                <TextBlock Text="Nincs még fiókod?" Foreground="#68738A" VerticalAlignment="Center"/>
                <Button x:Name="RegisterButton" Content="Regisztráció" Classes="linkButton"/>
            </StackPanel>
            <TextBlock Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="#9AA3B5" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
