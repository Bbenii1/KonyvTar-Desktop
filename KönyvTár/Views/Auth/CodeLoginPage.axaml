<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KönyvTár.Views.Auth.CodeLoginPage">
    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="300" Spacing="0">
            <TextBlock Text="Belépés e-mail kóddal" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0 0 0 14"/>
            <TextBlock Text="Kérj kódot e-mail címedre, majd írd be ide." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0 0 0 22"/>
            <StackPanel x:Name="EmailEntryPanel" Spacing="0">
                <TextBlock Text="E-mail cím" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBox x:Name="EmailTextBox" Classes="inputArea"/>
                <Button x:Name="RequestCodeButton" Content="Kód kérése" Classes="primaryButton" />
            </StackPanel>
            <StackPanel x:Name="CodeSentPanel" IsVisible="False" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="EmailSummary" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ChangeEmailButton" Grid.Column="1" Content="E-mail módosítása" Classes="linkButton"/>
                </Grid>
                <Button x:Name="ResendCodeButton" Content="Kód újraküldése" Classes="linkButton" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel x:Name="CodeEntryPanel" IsVisible="False" Spacing="0">
                <TextBlock Text="6 jegyű kód" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 16 0 10"/>
                <TextBox x:Name="CodeTextBox" MaxLength="6" PlaceholderText="123456" Classes="inputArea" TextAlignment="Left"/>
                <Button x:Name="SubmitCodeButton" Content="Belépés" Classes="primaryButton" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#C94C4C" FontSize="13" TextWrapping="Wrap" Margin="0 10 0 0" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <Button x:Name="BackButton" Content="Vissza a jelszavas belépéshez" Classes="linkButton" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            <TextBlock Text="© 2026 KönyvTár" HorizontalAlignment="Center" Foreground="#9AA3B5" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
